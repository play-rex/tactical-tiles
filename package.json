{
  "name": "tactical-tiles",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @tactical/server --filter @tactical/web dev",
    "build": "pnpm --filter @tactical/web build",
    "start": "pnpm --filter @tactical/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "ship": "bash deploy/deploy.sh"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "esbuild": "^0.25.0"
  }
}
