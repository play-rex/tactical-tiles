# Copy to deploy/.env (git-ignored).
#
# Leave TUNNEL_TOKEN empty to get a free temporary https://….trycloudflare.com address.
# For your own domain:
#   cloudflared tunnel create tactical-tiles
#   cloudflared tunnel route dns tactical-tiles tiles.example.com
#   cloudflared tunnel token tactical-tiles   → paste below
TUNNEL_TOKEN=
# The address people open (shown by `pnpm ship`).
PUBLIC_URL=
